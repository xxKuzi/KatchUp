# Stripe Checkout donation
STRIPE_SECRET_KEY=
STRIPE_DONATION_PRICE_ID=

# Google Ad Placement API (AdSense H5 Games Ads) — pays energy back for a
# watched rewarded ad. The publisher id is public by design: it identifies the
# site to AdSense, not the player. Leave it empty and the "watch an ad" button
# isn't offered at all.
#
# Both are NEXT_PUBLIC_, so they are baked in at build time — changing them on
# the host needs a redeploy, not a restart.
#
# NEXT_PUBLIC_ADSENSE_TEST=on serves mock ads without ever calling Google, and
# cycles between "ad ready" and "nothing to show" so both paths can be tried
# locally. Never set it in production. Real ads additionally need an approved
# AdSense account, H5 Games Ads allowlisting, and a certified CMP for EEA
# traffic.
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-0000000000000000
NEXT_PUBLIC_ADSENSE_TEST=on
